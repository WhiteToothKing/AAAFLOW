DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gameart_ai
REDIS_URL=redis://localhost:6379/0

ANTHROPIC_API_KEY=sk-ant-xxxxx
ANTHROPIC_MODEL=claude-sonnet-4-20250514

OPENAI_API_KEY=sk-xxxxx
OPENAI_CHAT_MODEL=gpt-4o
DALL_E_MODEL=dall-e-3

# 新建会话未指定时的默认提供方: anthropic | openai
DEFAULT_LLM_PROVIDER=anthropic

GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-image-preview

COMFYUI_API_URL=http://localhost:8188
COMFYUI_WS_URL=ws://localhost:8188/ws

UPLOAD_DIR=./uploads
OUTPUT_DIR=./outputs

JWT_SECRET_KEY=change-me-in-production
# 生产/等保：设为 true 后启动时校验 JWT 长度≥32、禁止默认密钥；SETUP_TOKEN 若设置则长度≥16
PRODUCTION_MODE=false
# 仅本地联调：true 时 API 不校验 JWT，固定使用库中最早创建的一名活跃用户（切勿在生产开启；PRODUCTION_MODE=true 时禁止）
AUTH_DISABLED=false
# 首次创建管理员：设置后可用 POST /api/auth/setup + 请求头 X-Setup-Token: <同值>
SETUP_TOKEN=
# 生产建议 false，并填写 CORS_ORIGINS（逗号分隔）
CORS_ALLOW_ALL=false
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
EXPOSE_OPENAPI=true

# 内网私有化：true 时关闭公开 /static，仅登录用户可通过 /api/files/uploads|outputs/{filename} 访问（前端需 VITE_STATIC_REQUIRE_AUTH=true）
STATIC_REQUIRE_AUTH=false

# Optional: Midjourney proxy
# MIDJOURNEY_API_URL=http://localhost:8080
# MIDJOURNEY_API_KEY=your-key

# Optional: 即梦 (Jimeng / 豆包) — volcengine API
# JIMENG_ACCESS_KEY=your-access-key
# JIMENG_SECRET_KEY=your-secret-key
JIMENG_MODEL=jimeng-2.1-pro

# Optional: MiniMax (海螺 AI)
# MINIMAX_API_KEY=your-key
MINIMAX_MODEL=image-01

# Optional: Banana Pro
# BANANA_API_KEY=your-key
BANANA_MODEL=banana-pro

# Optional: Figma → frontend（npm run figma:sync）；填真实值请写在 backend/.env 或仓库根目录 .env，勿写在本示例文件
# FIGMA_ACCESS_TOKEN=
# FIGMA_FILE_KEY=
# FIGMA_SHELL_NODE_ID=20:263496
# FIGMA_CLIENT_SCREENS_NODE_ID=131:283849
