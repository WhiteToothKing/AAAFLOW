# 复制为仓库根目录 `.env` 中的同名变量（根目录 .env 已在 .gitignore）
# Figma → 账户设置 → Personal access tokens
FIGMA_ACCESS_TOKEN=

# 文件 URL https://www.figma.com/design/XXXXXXXX/... 中 XXXXXXXX 一段
FIGMA_FILE_KEY=

# 要导出 / 解析的主 Frame 节点 id（Page 1「AAAFLOW Desktop Shell」）
FIGMA_SHELL_NODE_ID=20:263496

# 可选：画布页「AAAFLOW · 功能界面（客户端对照）」整页 PNG → public/figma/aaaflow-client-screens.png
FIGMA_CLIENT_SCREENS_NODE_ID=131:283849

# 可选：导出 PNG 的倍率（1–4）
FIGMA_EXPORT_SCALE=2
